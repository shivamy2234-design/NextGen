
@{
    ViewBag.Title = "About";
    Layout = "~/Views/Shared/_Layout.cshtml";
}


    <style>
        :root {
            --primary-blue: #5182d1;
            --primary-purple: #0c4371;
            --light-bg: #f8f9fa;
            --glass-white: rgba(255, 255, 255, 0.9);
        }

        body {
            font-family: 'Inter', 'Segoe UI', sans-serif;
            color: #2d3436;
            scroll-behavior: smooth;
        }

        .gradient-text {
            background: linear-gradient(45deg, var(--primary-blue), var(--primary-purple));
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            font-weight: 700;
        }

        .about-hero {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            padding: 120px 0 80px;
        }

        .text-navy {
            color: #0c4371;
        }

        .border-navy {
            border-color: #0c4371 !important;
        }

        .mission-box {
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            cursor: default;
            background-color: #ffffff !important;
            position: relative;
        }

            .mission-box:hover {
                transform: translateY(-8px);
                box-shadow: 0 15px 30px rgba(9, 32, 51, 0.12) !important;
                border-left-width: 8px !important;
                background-color: #f0f4f8 !important;
            }

        /* Mentor Cards */
        .instructor-card {
            background: white;
            border-radius: 15px;
            border: 1px solid rgba(0, 0, 0, 0.08);
            transition: 0.4s ease;
            height: 100%;
        }

            .instructor-card img {
                border-radius: 50%;
                transition: 0.4s ease;
                max-width: 140px;
                margin: 0 auto;
                filter: grayscale(100%);
            }

            .instructor-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 10px 25px rgba(0, 0, 0, 0.1);
            }

                .instructor-card:hover img {
                    filter: grayscale(0%);
                    transform: scale(1.05);
                    box-shadow: 0 10px 20px rgba(12, 67, 113, 0.2);
                }

        .stat-card {
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.05);
            transition: 0.4s ease;
            border: 1px solid rgba(0, 0, 0, 0.05);
            padding: 2rem;
        }

            .stat-card i {
                font-size: 2.5rem;
                margin-bottom: 1rem;
                color: var(--primary-purple);
            }

        /* More Button Styling */
        .btn-more {
            background: var(--primary-purple);
            color: white;
            border-radius: 30px;
            padding: 10px 30px;
            transition: 0.3s;
            border: none;
            font-weight: 600;
        }

            .btn-more:hover {
                background: var(--primary-blue);
                color: white;
                transform: scale(1.05);
            }
    </style>
            <section class="about-hero">
                <div class="container text-center">
                    <h1 class="display-3 fw-bold">Rendering the Future with <span class="gradient-text">NexGen Hub</span>
                    </h1>
                    <p class="lead text-muted mx-auto" style="max-width: 700px;">NextGen Learning Hub is more than a
                        platform. It's an ecosystem designed to turn students into industry leaders.</p>
                </div>
            </section>

            <section class="py-5 bg-white">
                <div class="container">
                    <div class="row align-items-center g-5">
                        <div class="col-lg-6">
                            <h2 class="fw-bold mb-4">Our Commitment to <span class="gradient-text">Applied Excellence</span>
                            </h2>
                            <p class="text-muted mb-4">At NextGen, we move beyond passive consumption. Our curriculum is
                                built on the principle of <strong>High-Impact Learning</strong>, ensuring that every hour
                                spent on our platform translates into tangible, professional skills.</p>
                            <ul class="list-unstyled">
                                <li class="mb-3 d-flex align-items-center"><i
                                        class="fas fa-check-circle text-navy me-3"></i> Real-world project simulations.</li>
                                <li class="mb-3 d-flex align-items-center"><i
                                        class="fas fa-check-circle text-navy me-3"></i> Quarterly curriculum updates aligned
                                    with market shifts.</li>
                                <li class="mb-3 d-flex align-items-center"><i
                                        class="fas fa-check-circle text-navy me-3"></i> Direct pathways to top-tier industry
                                    placement.</li>
                            </ul>
                        </div>
                        <div class="col-lg-6">
                            <div class="p-5 bg-light rounded-4 border-start border-navy border-5 shadow-sm mission-box">
                                <h5 class="fw-bold mb-3">The NextGen Mission</h5>
                                <p class="text-muted mb-0">To democratize access to elite-level technical education and
                                    foster a global community of innovators who are prepared to lead, not just follow.</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="py-5" id="stats-section">
                <div class="container">
                    <div class="row g-4 text-center">
                        <div class="col-md-3">
                            <div class="stat-card">
                                <i class="fas fa-users"></i>
                                <h2 class="fw-bold counter" data-target="15000">0</h2>
                                <p class="text-muted mb-0">Active Students</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card">
                                <i class="fas fa-book-open"></i>
                                <h2 class="fw-bold counter" data-target="450">0</h2>
                                <p class="text-muted mb-0">Total Courses</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card">
                                <i class="fas fa-award"></i>
                                <h2 class="fw-bold counter" data-target="98">0</h2>
                                <p class="text-muted mb-0">Satisfaction %</p>
                            </div>
                        </div>
                        <div class="col-md-3">
                            <div class="stat-card">
                                <i class="fas fa-laptop-code"></i>
                                <h2 class="fw-bold counter" data-target="120">0</h2>
                                <p class="text-muted mb-0">Expert Mentors</p>
                            </div>
                        </div>
                    </div>
                </div>
            </section>

            <section class="py-5 bg-light">
                <div class="container">
                    <div class="text-center mb-5">
                        <h2 class="fw-bold">Meet Our Mentors</h2>
                        <p class="text-muted">Top engineers and academics teaching you directly.</p>
                    </div>

                    <div class="row g-4 justify-content-center" id="mentor-container">
                        <div class="col-md-4 text-center">
                            <div class="instructor-card p-4 shadow-sm">
                                <img src="https://i.pravatar.cc/300?u=1" class="img-fluid mb-3 shadow" alt="Mentor Name">
                                <h5 class="fw-bold mb-1">Static Mentor (Design Preview)</h5>
                                <p class="small mb-2 text-uppercase fw-bold" style="color: #0c4371;">Expert Role</p>
                                <div class="d-flex justify-content-center gap-3">
                                    <a href="#"><i class="fab fa-linkedin text-muted"></i></a>
                                    <a href="#"><i class="fa-solid fa-user-tie text-muted"></i></a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="text-center mt-5">
                        <button class="btn btn-more shadow-sm">More +</button>
                    </div>
                </div>
            </section>

            <script>
                /** Vanilla JavaScript Counter Logic **/
                const startCounters = () => {
                    const counters = document.querySelectorAll('.counter');
                    const speed = 200; // Lower is slower

                    counters.forEach(counter => {
                        const updateCount = () => {
                            const target = +counter.getAttribute('data-target');
                            const count = +counter.innerText.replace(/,/g, '');
                            const inc = target / speed;

                            if (count < target) {
                                counter.innerText = Math.ceil(count + inc).toLocaleString();
                                setTimeout(updateCount, 10);
                            } else {
                                counter.innerText = target.toLocaleString();
                            }
                        };
                        updateCount();
                    });
                };

                // Intersection Observer to trigger counters when visible
                const observerOptions = { threshold: 0.5 };
                const observer = new IntersectionObserver((entries) => {
                    entries.forEach(entry => {
                        if (entry.isIntersecting) {
                            startCounters();
                            observer.unobserve(entry.target);
                        }
                    });
                }, observerOptions);

                const target = document.querySelector('#stats-section');
                if (target) observer.observe(target);


                /* fore more+ button to work */
                let currentOffset = 3; // We already showed 3 cards

    document.querySelector('.btn-more').addEventListener('click', function() {
        const button = this;
        button.innerHTML = 'Loading...'; // Visual feedback

        // 1. Fetch data from your Backend (The API)
        // We pass 'offset' so the database knows to skip the first 3
        fetch(`/Mentors/GetMoreMentors?offset=${currentOffset}`)
            .then(response => response.json())
            .then(data => {
                if (data.length > 0) {
                    const container = document.getElementById('mentor-container');

                    // 2. Loop through the JSON data from the database
                    data.forEach(mentor => {
                        const cardHtml = `
                            <div class="col-md-4 text-center">
                                <div class="instructor-card p-4 shadow-sm">
                                    <img src="${mentor.imagePath}" class="img-fluid mb-3 shadow" alt="${mentor.name}">
                                    <h5 class="fw-bold mb-1">${mentor.name}</h5>
                                    <p class="small mb-2 text-uppercase fw-bold" style="color: #0c4371;">${mentor.role}</p>
                                    <div class="d-flex justify-content-center gap-3">
                                        <a href="${mentor.linkedInUrl}"><i class="fab fa-linkedin text-muted"></i></a>
                                        <a href="${mentor.portfolioUrl}"><i class="fa-solid fa-user-tie text-muted"></i></a>
                                    </div>
                                </div>
                            </div>`;
                        container.insertAdjacentHTML('beforeend', cardHtml);
                    });

                    currentOffset += data.length; // Update our position
                    button.innerHTML = 'More +';
                } else {
                    button.innerHTML = 'No More Mentors';
                    button.disabled = true;
                }
            })
            .catch(error => {
                console.error('Error fetching mentors:', error);
                button.innerHTML = 'Error! Try Again';
            });
    });


            </script>
 

