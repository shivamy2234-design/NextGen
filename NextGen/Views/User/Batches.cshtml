
@{
    ViewBag.Title = "Batches";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

    <style>

        /* ========== GLOBAL ========== */
/*        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI',sans-serif;
        }*/

        body {
            background-color: #f5f7fa;
            font-family: Arial, sans-serif;
        }

        .batch-card {
            transition: 0.3s;
            border: none;
            border-radius: 15px;
            overflow: hidden;
        }

            .batch-card:hover {
                transform: translateY(-10px);
                box-shadow: 0 10px 20px rgba(0,0,0,0.2);
            }

        .image-placeholder {
            height: 200px;
            background: #d9d9d9;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            color: #555;
        }

        .price {
            color: #198754;
            font-size: 22px;
            font-weight: bold;
        }
    </style>


    <!-- Slider -->
    <div id="batchSlider" class="carousel slide container mt-4" data-bs-ride="carousel">

        <div class="carousel-inner rounded">

            <div class="carousel-item active">
                <img src="./Images/S.png"
                     class="d-block w-100" alt="slider">
            </div>

            <div class="carousel-item">
                <img src="./Images/S.png"
                     class="d-block w-100" alt="slider">
            </div>

            <div class="carousel-item">
                <img src="./Images/S.png"
                     class="d-block w-100" alt="slider">
            </div>

        </div>

        <button class="carousel-control-prev" type="button" data-bs-target="#batchSlider" data-bs-slide="prev">
            <span class="carousel-control-prev-icon"></span>
        </button>

        <button class="carousel-control-next" type="button" data-bs-target="#batchSlider" data-bs-slide="next">
            <span class="carousel-control-next-icon"></span>
        </button>

    </div>

