@{
    ViewBag.Title = "TeacherRegistration";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .teacher-register-page {
        --dark: #0f172a;
        --blue: #2563eb;
        --yellow: #facc15;
        --text: #334155;
        --light: #f8fafc;
        --error: #dc2626;
        --success: #16a34a;

        min-height: calc(100vh - 90px);
        background: linear-gradient(135deg, #0f172a, #172856, #215d40, #ffffff);
        background-size: 300% 300%;
        animation: teacherGradientMove 8s ease infinite;
        display: flex;
        justify-content: center;
        align-items: center;
        padding: 40px 15px;
    }

    @@keyframes teacherGradientMove {
        0% { background-position: 0% 50%; }
        50% { background-position: 100% 50%; }
        100% { background-position: 0% 50%; }
    }

    .teacher-register-page .teacher-form-container {
        width: 100%;
        max-width: 600px;
        background: rgba(255, 255, 255, 0.96);
        padding: 25px 24px;
        border-radius: 20px;
        box-shadow: 0 18px 45px rgba(0, 0, 0, 0.25);
        backdrop-filter: blur(10px);
    }

    .teacher-register-page .teacher-form-logo {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 6px;
        margin-bottom: 20px;
        text-align: center;
        text-decoration: none;
    }

    .teacher-register-page .teacher-form-logo img {
        height: 45px;
        display: block;
    }

    .teacher-register-page .teacher-form-logo h2 {
        font-size: 23px;
        color: var(--dark);
        margin: 0;
    }

    .teacher-register-page .teacher-input-group {
        margin-bottom: 12px;
        display: block;
    }

    .teacher-register-page label {
        font-size: 13px;
        font-weight: 600;
        color: var(--text);
        margin-bottom: 5px;
        display: block;
    }

    .teacher-register-page input,
    .teacher-register-page select {
        width: 100%;
        padding: 10px 12px;
        border: 1.5px solid #cbd5e1;
        border-radius: 8px;
        font-size: 14px;
        background: var(--light);
        outline: none;
        transition: 0.3s;
    }

    .teacher-register-page input:focus,
    .teacher-register-page select:focus {
        border-color: var(--blue);
        background: white;
        box-shadow: 0 0 0 3px rgba(37, 99, 235, 0.15);
    }

    .teacher-register-page .teacher-submit-btn {
        width: 100%;
        padding: 11px;
        background: linear-gradient(135deg, var(--yellow), #f59e0b);
        color: var(--dark);
        border: none;
        border-radius: 10px;
        font-size: 15px;
        font-weight: bold;
        cursor: pointer;
        margin-top: 8px;
        transition: 0.3s;
    }

    .teacher-register-page .teacher-submit-btn:hover {
        transform: translateY(-2px);
        box-shadow: 0 10px 25px rgba(250, 204, 21, 0.35);
    }

    .teacher-register-page .teacher-signin-link {
        text-align: center;
        margin-top: 15px;
        font-size: 13px;
    }

    .teacher-register-page .teacher-signin-link a {
        color: var(--blue);
        font-weight: bold;
        text-decoration: none;
    }

    .teacher-register-page .teacher-signin-link a:hover {
        text-decoration: underline;
    }

    .teacher-register-page .teacher-error-message {
        color: var(--error);
        font-size: 12px;
        margin-top: 4px;
        display: none;
    }

    .teacher-register-page .teacher-success-message {
        color: var(--success);
        text-align: center;
        font-size: 13px;
        font-weight: 600;
        margin-top: 10px;
        display: none;
    }

    @@media(max-width:480px) {
        .teacher-register-page {
            padding: 30px 12px;
        }

        .teacher-register-page .teacher-form-container {
            padding: 20px;
        }
    }
    .teacher-message {
        margin-top: 15px;
        padding: 12px;
        border-radius: 10px;
        text-align: center;
        font-size: 14px;
        font-weight: 600;
    }

        .teacher-message.success {
            background: #dcfce7;
            color: #166534;
        }

        .teacher-message.error {
            background: #fee2e2;
            color: #b91c1c;
        }
</style>

<div class="teacher-register-page">
    <div class="teacher-form-container">

        <a href="~/User/Index" class="teacher-form-logo">
            <img src="~/Content/images/nextgen.jpeg" alt="NextGen Logo">
            <h2>Join as Teacher</h2>
        </a>

        <form id="teacherForm" method="post">
            <div class="teacher-input-group">
                <label for="name">Full Name</label>
                <input type="text" name="TeacherName" id="name" placeholder="Enter full name" required>
            </div>

            <div class="teacher-input-group">
                <label for="email">Email</label>
                <input type="email" name="TeacherEmail" id="email" placeholder="example@mail.com" required>
            </div>

            <div class="teacher-input-group">
                <label for="course">Course</label>
                <select id="course" name="CourseName" required>
                    <option value="">Select course</option>
                    <option value="Web Development">Web Development</option>
                    <option value="Frontend">Frontend</option>
                    <option value="Backend">Backend</option>
                    <option value="Full Stack">Full Stack</option>
                    <option value="C# / .NET">C# / .NET</option>
                    <option value="Database">Database</option>
                </select>
            </div>

            <div class="teacher-input-group">
                <label for="experience">Experience</label>
                <select id="experience" name="Experience" required>
                    <option value="">Select experience</option>
                    <option value="Fresher">Fresher</option>
                    <option value="1 Year">1 Year</option>
                    <option value="2 Years">2 Years</option>
                    <option value="3+ Years">3+ Years</option>
                </select>
            </div>

            <div class="teacher-input-group">
                <label for="password">Password</label>
                <input type="password" id="password" name="Password" placeholder="Create password" required>
            </div>

            <div class="teacher-input-group">
                <label for="confirmPassword">Confirm Password</label>
                <input type="password" name="ConfirmPassword" id="confirmPassword" placeholder="Confirm password" required>
                <div id="errorMsg" class="teacher-error-message">Passwords do not match!</div>
            </div>

            <button type="submit" class="teacher-submit-btn">Create Account</button>

            @if (ViewBag.msg != null)
            {
                <div class="teacher-message @ViewBag.msgClass">
                    @ViewBag.msg
                </div>
            }

            <div class="teacher-signin-link">
                Already have account?
                <a href="~/Teacher/TeacherLogin">Login</a>
            </div>
        </form>

    </div>
</div>

<script>
    const teacherForm = document.getElementById("teacherForm");
    const teacherPassword = document.getElementById("password");
    const teacherConfirmPassword = document.getElementById("confirmPassword");
    const teacherErrorMsg = document.getElementById("errorMsg");

    teacherForm.addEventListener("submit", function (e) {

        if (teacherPassword.value !== teacherConfirmPassword.value) {

            e.preventDefault();

            teacherErrorMsg.style.display = "block";
            teacherConfirmPassword.style.borderColor = "#dc2626";
        }
    });

    teacherConfirmPassword.addEventListener("input", function () {

        teacherErrorMsg.style.display = "none";
        teacherConfirmPassword.style.borderColor = "#cbd5e1";

    });
</script>