@model List<NextGen.Models.Course>
@{
    ViewBag.Title = "Batches";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>


    body {
        background-color: #f5f7fa;
        font-family: Arial, sans-serif;
    }

    .batch-card {
        transition: 0.3s;
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }

        .batch-card:hover {
            transform: translateY(-10px);
            box-shadow: 0 10px 20px rgba(0,0,0,0.2);
        }

    .image-placeholder {
        height: 200px;
        background: #d9d9d9;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        color: #555;
    }

    .price {
        color: #198754;
        font-size: 22px;
        font-weight: bold;
    }
    /* Slider Image Fix */
    #batchSlider {
        max-width: 1200px;
    }

        #batchSlider .carousel-item img {
            height: 360px;
            width: 100%;
            object-fit: cover;
            border-radius: 18px;
        }

    /* Card Image Fix */
    .batch-card img {
        height: 180px;
        width: 100%;
        object-fit: cover;
    }

    /* Card Equal Height */
    .batch-card {
        height: 100%;
        transition: 0.3s;
        border: none;
        border-radius: 15px;
        overflow: hidden;
    }

        .batch-card .card-body {
            min-height: 230px;
            display: flex;
            flex-direction: column;
        }

        .batch-card .enroll-btn {
            margin-top: auto;
        }

    /* Mobile Responsive */
    @@media (max-width: 768px) {
        #batchSlider .carousel-item img {
            height: 220px;
        }

        .batch-card img {
            height: 170px;
        }
    }
</style>


<!-- Slider -->
<div id="batchSlider" class="carousel slide container mt-4" data-bs-ride="carousel">

    <div class="carousel-inner rounded">

        <div class="carousel-item active">
            <img src="~/Content/images/1.png"
                 class="d-block w-100" alt="slider">
        </div>

        <div class="carousel-item">
            <img src="~/Content/images/2.png"
                 class="d-block w-100" alt="slider">
        </div>

        <div class="carousel-item">
            <img src="~/Content/images/3.png"
                 class="d-block w-100" alt="slider">
        </div>

        <div class="carousel-item">
            <img src="~/Content/images/4.png"
                 class="d-block w-100" alt="slider">
        </div>

        <div class="carousel-item">
            <img src="~/Content/images/5.png"
                 class="d-block w-100" alt="slider">
        </div>

        <div class="carousel-item">
            <img src="~/Content/images/6.png"
                 class="d-block w-100" alt="slider">
        </div>

        <div class="carousel-item">
            <img src="~/Content/images/7.png"
                 class="d-block w-100" alt="slider">
        </div>
        <div class="carousel-item">
            <img src="~/Content/images/8.png"
                 class="d-block w-100" alt="slider">
        </div>

    </div>

    <button class="carousel-control-prev" type="button" data-bs-target="#batchSlider" data-bs-slide="prev">
        <span class="carousel-control-prev-icon"></span>
    </button>

    <button class="carousel-control-next" type="button" data-bs-target="#batchSlider" data-bs-slide="next">
        <span class="carousel-control-next-icon"></span>
    </button>

</div>
@*heading*@
<div class="container text-center mt-5">
    <h1 class="fw-bold">Explore Our Popular Courses</h1>
    <p class="text-muted">
        Upgrade your skills with industry-ready courses.
    </p>
</div>

<!-- Batch Cards -->
<section class="container my-5">
    <div class="row g-4">

        @foreach (var item in Model)
        {
            <div class="col-md-3">
                <div class="card batch-card">
                    <img src="@Url.Content(item.CourseImage)" class="card-img-top" alt="@item.CourseName">

                    <div class="card-body">
                        <h5>@item.CourseName</h5>

                        <p>
                            Learn @item.CourseName with NextGen expert teachers.
                        </p>

                        <p>
                            <strong>Duration:</strong> @item.Duration
                        </p>

                        <p>
                            <strong>Time:</strong> @item.StartTime - @item.EndTime
                        </p>

                        <p class="price">₹@item.CoursePrice</p>

                        <a href="@Url.Action("CourseDetails", "User", new { id = item.Id })"
                           class="btn btn-primary enroll-btn">
                            Enroll Now
                        </a>
                    </div>
                </div>
            </div>
        }

    </div>
</section>


<script>
    document.querySelector(".menu-toggle").onclick = () => {
        document.querySelector(".nav-links").classList.toggle("show");
    };

    document.querySelectorAll(".dropdown").forEach(item => {
        item.addEventListener("click", () => {
            item.querySelector(".dropdown-menu").classList.toggle("showDropdown");
        });
    });

</script>


