@{
    ViewBag.Title = "Our Team";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<link href="~/Content/css/ourteam.css" rel="stylesheet" />

<section class="team-hero">
    <div class="hero-content">
        <span class="badge-text">NextGen Development Team</span>
        <h1>Meet The Minds Behind NextGen</h1>
        <p>
            NextGen Learning Platform is built with teamwork, creativity and modern technology
            to provide students a better online learning experience.
        </p>

        <div class="hero-buttons">
            <a href="#team" class="btn-main">Meet Team</a>
            <a href="#project" class="btn-outline">View Project Work</a>
        </div>
    </div>
</section>

<section class="project-section" id="project">
    <div class="section-title">
        <h2>About NextGen Project</h2>
        <p>Our platform includes multiple modules for students, teachers and admins.</p>
    </div>

    <div class="feature-grid">
        <div class="feature-card">Student Login & Dashboard</div>
        <div class="feature-card">Teacher Panel</div>
        <div class="feature-card">Admin Dashboard</div>
        <div class="feature-card">Course & Batch Management</div>
        <div class="feature-card">Contact & Enquiry System</div>
        <div class="feature-card">Feedback Management</div>
        <div class="feature-card">Responsive UI Design</div>
        <div class="feature-card">Database Integration</div>
    </div>
</section>

<section class="stats-section">
    <div class="stat-box">
        <h3>3+</h3>
        <p>Dashboards</p>
    </div>
    <div class="stat-box">
        <h3>20+</h3>
        <p>Features</p>
    </div>
    <div class="stat-box">
        <h3>5+</h3>
        <p>Team Members</p>
    </div>
    <div class="stat-box">
        <h3>100%</h3>
        <p>Responsive</p>
    </div>
</section>

